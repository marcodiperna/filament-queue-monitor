{
    "name": "p2tinformatica/filament-queue-monitor",
    "description": "Code, job falliti e batch di Laravel nel pannello Filament, sulle tabelle standard del driver database: nessuna tabella in piu', nessun listener.",
    "keywords": ["laravel", "filament", "queue", "jobs", "failed-jobs", "monitor"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "P2T Informatica",
            "homepage": "https://p2tinformatica.it",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "P2TInformatica\\FilamentQueueMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "P2TInformatica\\FilamentQueueMonitor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "P2TInformatica\\FilamentQueueMonitor\\QueueMonitorServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
